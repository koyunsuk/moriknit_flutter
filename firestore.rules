rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── 공통 함수 ──────────────────────────────────────────────────────────────
    function isLoggedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isLoggedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isLoggedIn() && request.auth.token.email == 'koyunsuk@gmail.com';
    }

    // ── 청사진 권한 helpers (이슈 #687) ────────────────────────────────────────
    function isBlueprintOwner(bid) {
      return isLoggedIn()
        && exists(/databases/$(database)/documents/step_blueprints/$(bid))
        && get(/databases/$(database)/documents/step_blueprints/$(bid)).data.ownerUid == request.auth.uid;
    }
    function isBlueprintOwnerOrAdmin(bid) {
      return isBlueprintOwner(bid) || isAdmin();
    }
    function hasBlueprintMemberRole(bid) {
      return isLoggedIn()
        && exists(/databases/$(database)/documents/step_blueprints/$(bid))
        && (request.auth.uid in get(/databases/$(database)/documents/step_blueprints/$(bid)).data.members);
    }
    function isBlueprintEditor(bid) {
      // 본인이 admin/editor 멤버이거나 청사진 owner
      return isBlueprintOwner(bid) || (
        hasBlueprintMemberRole(bid)
        && (
          get(/databases/$(database)/documents/step_blueprints/$(bid)).data.members[request.auth.uid] == 'admin'
          || get(/databases/$(database)/documents/step_blueprints/$(bid)).data.members[request.auth.uid] == 'editor'
        )
      );
    }
    function hasPurchase(bid) {
      // purchases/{auto}: { userUid, blueprintId, status: 'completed' }
      // 클라이언트에서 단순 query/exists 어렵기 때문에 핵심 정책은
      // Cloud Functions에서 사후 검증. 본 helper는 marketplace fallback.
      return false;
    }

    // ── 스와치 그룹 (이슈 #772) ────────────────────────────────────────────────
    // users/{uid}/swatch_groups/{gid}
    match /users/{uid}/swatch_groups/{gid} {
      allow read, write: if isOwner(uid);
    }

    // ── 핸들 reservation (이슈 #771) ────────────────────────────────────────────
    // handles/{handle} : 문서 ID = 소문자 normalized handle
    //   data: { userId, displayHandle, reservedAt }
    // 정책:
    //   - read: 로그인 사용자 (중복 체크/멘션 해소)
    //   - create: 자기 자신 + 형식 검증 (^[a-z0-9_]{3,20}$) + 미존재
    //   - update: deny (변경은 delete + create 트랜잭션으로만)
    //   - delete: 자기 자신 또는 admin
    match /handles/{handle} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn()
                   && request.resource.data.userId == request.auth.uid
                   && handle.matches('^[a-z0-9_]{3,20}$')
                   && request.resource.data.displayHandle == handle;
      allow update: if false;
      allow delete: if isLoggedIn()
                   && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ── 사용자 프로필 ───────────────────────────────────────────────────────────
    // 어드민은 모든 사용자 문서/하위 컬렉션을 삭제할 수 있도록 isAdmin() 분기 추가 (회원 일괄 삭제용).
    match /users/{uid} {
      allow read: if isLoggedIn();
      allow write: if isOwner(uid) || isAdmin();

      // 프로젝트
      match /projects/{projectId} {
        allow read, write: if isOwner(uid) || isAdmin();
        // 프로젝트 단계로그
        match /steps/{stepId} {
          allow read, write: if isOwner(uid) || isAdmin();
        }
        // 프로젝트 카운터
        match /counters/{counterId} {
          allow read, write: if isOwner(uid) || isAdmin();
        }
      }
      // 스와치
      match /swatches/{swatchId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
      // 카운터
      match /counters/{counterId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
      // 템플릿
      match /templates/{templateId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
      // 바늘
      match /myNeedles/{needleId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
      // 악세서리
      match /myAccessories/{itemId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
      // 실
      match /myYarns/{yarnId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
      // 도서
      match /books/{bookId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
      // 메모
      match /memos/{memoId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
      // 도안 차트
      match /pattern_charts/{chartId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
      // AI 파싱 결과
      match /parsed_patterns/{docId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
      // 개인 백과사전
      match /personal_encyclopedia/{entryId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
      // 단계로그
      match /steps/{stepId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
      // 마켓 구매/판매 내역
      match /market_purchases/{docId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
      match /market_sales/{docId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
      // DM 룸
      match /dm_rooms/{roomId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
      // 패턴 파일 (Dropbox 임포트)
      match /pattern_files/{fileId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
      // AI 도안 변환 작업
      match /ai_jobs/{jobId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
      // 도안 뷰어 세션 (자 위치, 스티키노트, 형광펜, 프로젝트/스와치 연결)
      match /pattern_sessions/{sessionId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
      // 이슈 #624 — 도구함 자유 타이머 (단일 문서 'doc')
      match /free_timer/{docId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
      // 이슈 #630 — 스와치별 작업시간 타이머
      match /swatch_timers/{swatchId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
      // 이슈 #654 — Dropbox 즐겨찾기 (path/name/addedAt)
      match /dropbox_favorites/{fileId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
      // 이슈 #687 — 청사진 마이그레이션 완료 플래그 (MigrationGuard)
      match /migration_meta/{docId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
    }

    // ── 마켓 아이템 (공개 읽기, 로그인 후 생성/수정) ────────────────────────────
    match /market_items/{itemId} {
      allow read: if true;
      allow create: if isLoggedIn();
      allow update, delete: if isLoggedIn()
        && resource.data.sellerUid == request.auth.uid;
    }

    // ── 커뮤니티 게시글 ────────────────────────────────────────────────────────
    match /posts/{postId} {
      allow read: if true;
      allow create: if isLoggedIn();
      allow update, delete: if isLoggedIn()
        && resource.data.uid == request.auth.uid;

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isLoggedIn();
        allow update, delete: if isLoggedIn()
          && resource.data.uid == request.auth.uid;
      }
    }

    // ── 공개 프로젝트 ──────────────────────────────────────────────────────────
    match /public_projects/{projectId} {
      allow read: if true;
      allow create: if isLoggedIn();
      allow update, delete: if isLoggedIn()
        && resource.data.uid == request.auth.uid;

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isLoggedIn();
        allow update, delete: if isLoggedIn()
          && resource.data.uid == request.auth.uid;
      }
    }

    // ── 방명록 ─────────────────────────────────────────────────────────────────
    match /guestbook/{docId} {
      allow read: if true;
      allow create: if isLoggedIn();
      allow update, delete: if isLoggedIn()
        && resource.data.uid == request.auth.uid;
    }

    // ── 기본 템플릿 (공개 읽기, 관리자만 쓰기) ────────────────────────────────
    match /builtin_templates/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── 실/바늘 브랜드 마스터 (로그인 읽기, 사용자도 추가 가능, 어드민만 수정/삭제) ──
    // 사용자가 새 브랜드 입력 시 자동 누적 (한국 브랜드 자체 DB 성장)
    match /yarn_brands/{brandId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn();
      allow update, delete: if isAdmin();
    }
    match /needle_brands/{brandId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn();
      allow update, delete: if isAdmin();
    }

    // ── 뜨개백과 (공개 읽기, 관리자만 쓰기) ────────────────────────────────────
    match /encyclopedia/{entryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── 클라스 / 코스 (공개 읽기, 관리자만 쓰기) ─────────────────────────────────
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── 도안 기호 (공개 읽기, 관리자만 쓰기) ──────────────────────────────────────
    match /knit_symbols/{symbolId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── 랜딩 게시판 (공개 읽기, 로그인 후 쓰기) ─────────────────────────────────
    match /landing_boards/{boardType}/posts/{postId} {
      allow read: if true;
      allow create: if isLoggedIn();
      allow update, delete: if isLoggedIn()
        && resource.data.uid == request.auth.uid;

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isLoggedIn();
        allow update, delete: if isLoggedIn()
          && resource.data.uid == request.auth.uid;
      }
    }

    // ── 공지사항 (공개 읽기, 관리자만 쓰기) ──────────────────────────────────────
    match /landing_notices/{noticeId} {
      allow read: if true;
      allow write: if isAdmin();

      // 공지사항 댓글 (이슈 #796) — landing_board_repository.addNoticeComment 에서 사용.
      // collectionGroup('comments') 쿼리가 이 경로도 평가하므로 룰 명시 필요.
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isLoggedIn();
        allow update, delete: if isLoggedIn()
          && resource.data.uid == request.auth.uid;
      }
    }

    // ── 마이페이지: 내가 쓴 댓글 (이슈 #796) ─────────────────────────────────────
    // collectionGroup('comments') where uid == request.auth.uid 본인 쿼리 허용.
    // Firestore rules 의 List 권한은 query.where 절이 정확히 본인 필터일 때만 통과.
    match /{path=**}/comments/{commentId} {
      allow read: if isLoggedIn()
        && resource.data.uid == request.auth.uid;
    }

    // ── 어드민 사용자 데이터 CollectionGroup 읽기 ────────────────────────────────
    match /{path=**}/swatches/{docId} {
      allow read: if isAdmin();
    }
    match /{path=**}/pattern_charts/{docId} {
      allow read: if isAdmin();
      // 어드민 일괄 마이그레이션 (#651 옵션 A): imageUrl 채우기 등
      allow update: if isAdmin();
    }
    match /{path=**}/templates/{docId} {
      allow read: if isAdmin();
    }
    match /{path=**}/projects/{docId} {
      allow read: if isAdmin();
    }
    match /{path=**}/counters/{docId} {
      allow read: if isAdmin();
    }
    match /{path=**}/steps/{docId} {
      allow read: if isAdmin();
    }
    match /{path=**}/market_purchases/{docId} {
      allow read: if isAdmin();
    }

    // ── 뉴스레터 구독 (비로그인 쓰기 허용) ──────────────────────────────────────
    match /landing_subscriptions/{docId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // ── 버그 신고 (로그인 후 쓰기) ────────────────────────────────────────────
    // 이슈 #807/#813 — 어드민만 list/read/update/delete (일반 사용자 조회 UI 없음).
    // AI 워커는 Firebase Admin SDK로 우회.
    match /bug_reports/{docId} {
      allow create: if isLoggedIn();
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // ── DM 채팅 (참여자만) ────────────────────────────────────────────────────
    match /dm_rooms/{roomId} {
      allow read, write: if isLoggedIn()
        && (resource == null || request.auth.uid in resource.data.participants);

      match /messages/{messageId} {
        allow read, write: if isLoggedIn();
      }
    }

    // ── 앱 설정 / UI 카피 (공개 읽기, 관리자만 쓰기) ──────────────────────────────
    match /app_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /ui_copy/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── 에디토리얼 포스트 (로그인 사용자 읽기, 관리자만 쓰기) ────────────────────────
    match /editorial_posts/{docId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    // ── 청사진 (이슈 #687 Phase G) ──────────────────────────────────────────────
    // step_blueprints/{bid} : 전역 컬렉션, ownerUid 필드로 소유자 식별
    match /step_blueprints/{bid} {
      allow read: if isLoggedIn() && (
            resource.data.ownerUid == request.auth.uid
            || resource.data.visibility == 'public'
            || resource.data.visibility == 'unlisted'
            || resource.data.visibility == 'community_showcase'
            || (resource.data.visibility == 'marketplace' && hasPurchase(bid))
            || hasBlueprintMemberRole(bid)
            || isAdmin()
          );
      allow create: if isLoggedIn()
                   && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isBlueprintOwnerOrAdmin(bid);

      // 청사진 단위
      match /units/{unitId} {
        allow read: if isLoggedIn() && (
              // 부모 청사진이 읽기 가능한 사용자거나, preview 단위(마켓 미리보기)
              get(/databases/$(database)/documents/step_blueprints/$(bid)).data.ownerUid == request.auth.uid
              || get(/databases/$(database)/documents/step_blueprints/$(bid)).data.visibility == 'public'
              || get(/databases/$(database)/documents/step_blueprints/$(bid)).data.visibility == 'unlisted'
              || get(/databases/$(database)/documents/step_blueprints/$(bid)).data.visibility == 'community_showcase'
              || (get(/databases/$(database)/documents/step_blueprints/$(bid)).data.visibility == 'marketplace'
                  && (resource.data.isPreview == true || hasPurchase(bid)))
              || hasBlueprintMemberRole(bid)
              || isAdmin()
            );
        allow write: if isBlueprintEditor(bid) || isAdmin();
      }
    }

    // ── 사용자 청사진 실행 (StepRun) ────────────────────────────────────────────
    match /users/{uid}/step_runs/{rid} {
      allow read, write: if isOwner(uid);

      match /progress/{unitId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ── 구매 (마켓플레이스 청사진 구매) ────────────────────────────────────────
    // purchases/{pid}: { userUid, blueprintId, status, amountCents, ... }
    match /purchases/{pid} {
      allow read: if isLoggedIn()
                 && resource.data.userUid == request.auth.uid;
      // 클라이언트에서 만든 결제 요청은 status=pending 까지만.
      // 결제 완료 status=completed 전환은 Cloud Functions(서버)가 책임.
      allow create: if isLoggedIn()
                   && request.resource.data.userUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ── 발행 글 (Article) ──────────────────────────────────────────────────────
    match /articles/{aid} {
      allow read: if (resource.data.publishStatus == 'published')
                 || (isLoggedIn() && resource.data.authorUid == request.auth.uid)
                 || isAdmin();
      allow create: if isLoggedIn()
                   && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if isLoggedIn()
                           && resource.data.authorUid == request.auth.uid;
    }

    // ── 어드민 청사진 CollectionGroup 읽기 ──────────────────────────────────────
    match /{path=**}/step_runs/{rid} {
      allow read: if isAdmin();
    }
    match /{path=**}/progress/{unitId} {
      allow read: if isAdmin();
    }

    // ── #806 — 랜딩 사이트 CMS 페이지 (어드민 편집, 모두 읽기) ────────────────
    match /landing_pages/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
      match /sections/{sectionId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

  }
}
